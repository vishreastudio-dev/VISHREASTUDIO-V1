# Supabase Authentication Configuration (Client-side)
# VITE_SUPABASE_URL is the Supabase Project URL, e.g. https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY is the public/anon publishable key.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or JWT_SECRET here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
