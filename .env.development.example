# ==============================================================================
# Vishrea Studio — DEVELOPMENT template. Never the production Supabase project.
# Copy to .env on a developer machine. See docs/security/FINAL_STORAGE_PRODUCTION_READINESS.md
# ("Development isolation") for creating the development Supabase project.
# ==============================================================================
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=

# The LIVE project's reference: the <ref> in https://<ref>.supabase.co. It is public (it appears in
# every product image URL). While it is set, the local server refuses to start if DATABASE_URL or
# SUPABASE_URL point at that project, and maintenance scripts refuse to write to it without --production.
PRODUCTION_SUPABASE_PROJECT_REF=

# Any random 32+ character value; generate with crypto.randomBytes(48).toString('hex').
# Never reuse the production value.
JWT_SECRET=
DEFAULT_ADMIN_EMAIL=dev-admin@localhost.test

# Option A (simplest): local PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vishrea
DATABASE_SSL=false
# Option B: the DEVELOPMENT Supabase project's database (never the live one):
# DATABASE_URL=postgresql://postgres:<dev-db-password>@db.<dev-project-ref>.supabase.co:5432/postgres
# DATABASE_SSL=true
# ALLOW_REMOTE_DATABASE=true

# Shows the sign-in code on the login page. Refused when DATABASE_URL is remote.
AUTH_DEV_OTP_ECHO=true
RESEND_API_KEY=

# Option A: uploads go to ./public/uploads.
STORAGE_DRIVER=local
# Option B: the DEVELOPMENT Supabase project's storage (run `npm run storage:setup -- --fix` once):
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://<dev-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # the dev project's key; server-side only, never VITE_*

# Razorpay TEST keys only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
