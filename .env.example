# ==============================================================================
# Vishrea Studio — server configuration (copy to .env; never commit real values)
# Everything here is SERVER-SIDE. Nothing in this file may be exposed as VITE_*.
# ==============================================================================

PORT=3000
NODE_ENV=development

# Public https origin of the storefront. REQUIRED in production (used for CSRF origin
# checks, canonical HTTPS redirects, sitemap and robots.txt).
APP_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API with cookies (comma separated). Usually empty.
CORS_ORIGINS=
# Behind a TLS-terminating proxy/load balancer: number of trusted hops (default 1 in production).
# TRUST_PROXY=1
# FORCE_HTTPS=true          # defaults to true in production
# CSP_MODE=enforce          # enforce | report-only | off (defaults: enforce in production)

# Session signing secret: 64+ random characters. The server refuses to start in production
# without a strong value. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=14
# Optional separate pepper for hashing one-time codes (defaults to JWT_SECRET).
OTP_PEPPER=

# First administrator (bootstrapped by `npm run migrate` only when no admin exists).
# Admin rights come only from the profiles table — never from the email address pattern.
DEFAULT_ADMIN_EMAIL=
# Owner-approved admin emails, comma-separated. When set, only these accounts (with an admin role) have admin access.
ADMIN_ALLOWED_EMAILS=

# Email (Resend): sign-in codes and dispatch / pickup notices.
# Production sign-in is disabled until RESEND_API_KEY is set. The sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Vishrea Studio <no-reply@vishreastudio.com>
# Development only: return the code in the API response (ignored when NODE_ENV=production).
AUTH_DEV_OTP_ECHO=false

# PostgreSQL. Development must use a local or staging database: the server refuses to start in
# development when DATABASE_URL is remote unless ALLOW_REMOTE_DATABASE=true (never set that for the
# production database), and never echoes sign-in codes while connected to a remote database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vishrea
DATABASE_SSL=false
# ALLOW_REMOTE_DATABASE=false
# Verify the database TLS certificate (recommended for hosted PostgreSQL / Supabase).
# DATABASE_SSL_CA_FILE=/etc/ssl/supabase-ca.crt
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000

# Razorpay (the key secret and webhook secret never leave the server)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret for https://<APP_ORIGIN>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Optional. Not used to create a charge. Membership checkout is an upfront order
# (monthly price × upfront months). A Razorpay Plan id belongs here only if autopay is added later.
RAZORPAY_MEMBERSHIP_PLAN_ID=
# Automatically refund a captured payment when the piece sold out before it completed.
RAZORPAY_AUTO_REFUND=true

# Media storage. "local" (development default) writes to UPLOADS_DIR; "supabase" (required in
# production) stores files in Supabase Storage. See docs/security/MEDIA_STORAGE_ARCHITECTURE.md.
# STORAGE_DRIVER=local
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# The LIVE project's <project-ref> (public, not a secret). Outside production the server refuses to
# start against it, and scripts need --production to write to it. In production it must match SUPABASE_URL.
PRODUCTION_SUPABASE_PROJECT_REF=
# SERVER-SIDE ONLY. Bypasses row-level security: never prefix with VITE_, never send it to the
# browser, never paste it into logs or tickets. The React app does not need any Supabase key.
SUPABASE_SERVICE_ROLE_KEY=
# Lifetime of private links (exchange evidence, archive) in seconds: 30–3600, default 300.
# STORAGE_SIGNED_URL_SECONDS=300
# Per-request timeout for storage calls in milliseconds: 2000–120000, default 20000.
# STORAGE_TIMEOUT_MS=20000
# Bucket names (defaults shown). Public: products, banners, instagram, videos. Private: evidence, archive.
# STORAGE_BUCKET_PRODUCTS=product-images
# STORAGE_BUCKET_BANNERS=homepage-banners
# STORAGE_BUCKET_INSTAGRAM=instagram-media
# STORAGE_BUCKET_VIDEOS=customer-feedback
# STORAGE_BUCKET_EVIDENCE=exchange-evidence
# STORAGE_BUCKET_ARCHIVE=media-archive

# Local driver only: uploads directory (defaults to ./public/uploads).
# UPLOADS_DIR=/var/lib/vishrea/uploads
# Local driver only: remove uploads no record references once older than this many days
# (disabled when unset). For Supabase use the dry-run scanner: npm run media:orphans
# UPLOAD_ORPHAN_CLEANUP_DAYS=30

# AI Listing Studio (optional, admin only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
