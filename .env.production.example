# ==============================================================================
# Vishrea Studio — PRODUCTION template. Copy into the host's secret store (not into git).
# The server refuses to start in production if any required value is missing or weak.
# ==============================================================================
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://vishreastudio.com
PUBLIC_SITE_URL=https://vishreastudio.com
CORS_ORIGINS=
TRUST_PROXY=1

# 48 random bytes, hex. Generate on the server: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating it signs every customer out (see docs/archive/2026-11-05-remediation-audit/VISHREA_AUDIT_REMEDIATION_REPORT.md → secret rotation).
JWT_SECRET=
OTP_PEPPER=
SESSION_DAYS=14
# Must stay false/unset in production (startup fails if true).
AUTH_DEV_OTP_ECHO=false

# Only bootstraps the first administrator when no admin exists. Use a mailbox on a domain the business controls.
DEFAULT_ADMIN_EMAIL=
# Owner-approved admin emails, comma-separated. When set, only these accounts (with an admin role) have admin access.
ADMIN_ALLOWED_EMAILS=

# Production Supabase PostgreSQL (direct connection). Verify the certificate.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=

# Resend: sender domain must be verified in Resend before go-live.
RESEND_API_KEY=
EMAIL_FROM=Vishrea Studio <no-reply@vishreastudio.com>

# Razorpay LIVE keys — only after owner approval. Webhook: https://vishreastudio.com/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_AUTO_REFUND=true

# Media storage: Supabase Storage is required in production (startup fails otherwise).
# Run `npm run storage:setup` (report) then `npm run storage:setup -- --fix` once to create the buckets.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# The same <project-ref>. Startup fails if SUPABASE_URL belongs to a different project.
PRODUCTION_SUPABASE_PROJECT_REF=<project-ref>
# SERVER-SIDE ONLY — keep in the host's secret store. Never VITE_*, never in the frontend build.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_SIGNED_URL_SECONDS=300
STORAGE_TIMEOUT_MS=20000
# Optional bucket overrides (defaults: product-images, homepage-banners, instagram-media,
# customer-feedback, exchange-evidence [private], media-archive [private]).
# STORAGE_BUCKET_PRODUCTS=
# STORAGE_BUCKET_BANNERS=
# STORAGE_BUCKET_INSTAGRAM=
# STORAGE_BUCKET_VIDEOS=
# STORAGE_BUCKET_EVIDENCE=
# STORAGE_BUCKET_ARCHIVE=
# Automatic orphan deletion stays OFF. Review with `npm run media:orphans` (dry run) and delete only
# with owner approval: `npm run media:orphans -- --delete --confirm=<count>`.

OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
